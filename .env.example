# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# 🌱 KisaanSathi Supabase Backend Configuration
# ==============================================================================
# Provide your Supabase project credentials below.
# Find these in your Supabase project settings at: https://supabase.com/dashboard/project/_/settings/api
# The application includes a self-bootstrapping PostgreSQL migration script in /supabase/schema.sql
#
# VITE_SUPABASE_URL: Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=""
# VITE_SUPABASE_ANON_KEY: Project Anon / Public API Key
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Optional backend service key for admin bypass/backend triggers
SUPABASE_SERVICE_ROLE_KEY=""

